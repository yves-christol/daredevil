{
  "name": "daredevil",
  "version": "0.1.0",
  "private": true,
  "description": "Accessibility auditing: axe-core + Playwright crawler, reproducible scoring, AI-ready reports",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "audit": "tsx src/cli.ts audit",
    "login": "tsx src/cli.ts login",
    "diff": "tsx src/cli.ts diff",
    "render": "tsx src/cli.ts render",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.14.1",
    "playwright": "1.65.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
